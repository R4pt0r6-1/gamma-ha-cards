{
  "name": "gamma-ha-cards",
  "version": "0.1.0",
  "type": "module",
  "description": "A collection of fast Home Assistant Lovelace dashboard cards",
  "main": "gamma-ha-cards.js",
  "scripts": {
    "build": "vite build && cp dist/gamma-ha-cards.js gamma-ha-cards.js && cp dist/gamma-ha-cards.js.map gamma-ha-cards.js.map",
    "demo": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "lovelace",
    "hacs",
    "custom-card",
    "light",
    "switch",
    "dashboard-cards"
  ],
  "author": {
    "name": "AnielGammaTech",
    "url": "https://github.com/AnielGammaTech"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnielGammaTech/gamma-ha-cards.git"
  },
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.2"
  }
}
